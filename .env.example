# Hive — copy to .env.local

# Optional Stripe (test mode). If unset, the demo wallet still settles instantly.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional Lightning via LNbits. If unset, Hive shows a test invoice + "I paid".
LNBITS_URL=
LNBITS_ADMIN_KEY=

# WebRTC. STUN is enough for two tabs on one machine and most office LANs.
NEXT_PUBLIC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# TURN — required to punch through many office NATs / guest Wi-Fi / phone LTE.
# Metered, Twilio, or a coturn you run with docker compose.
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# Optional ledger file location
# HIVE_LEDGER_PATH=./data/ledger.json

# Discord bot (desktop app or `cargo run -p hive-discord`)
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=

# Where the desktop / Discord bot reaches the Hive web hub
HIVE_URL=http://127.0.0.1:43177

# Optional local config dir for pairing + device id
# HIVE_CONFIG_DIR=~/.config/hive
# HIVE_PAIRING_PATH=./data/pairing.json
