{
  "name": "hive",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "Mike Holborn",
  "description": "Building-scale mesh inference. Join a group, optionally share compute, unlock models from pooled VRAM, pay contributors per token.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hewlbern/hive.git"
  },
  "bugs": {
    "url": "https://github.com/Hewlbern/hive/issues"
  },
  "homepage": "https://github.com/Hewlbern/hive",
  "scripts": {
    "dev": "next dev -p 43177 --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start -p 43177 --hostname 0.0.0.0",
    "lint": "eslint",
    "test": "vitest run && playwright test",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:rust": "cargo test --workspace --exclude hive-desktop",
    "desktop:dev": "cargo tauri dev",
    "desktop:build": "cargo tauri build",
    "discord": "cargo run -p hive-discord"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.80",
